# ===== GIGACHAT API =====
# Ключ авторизации из личного кабинета GigaChat API
# Получить: https://developers.sber.ru/ -> GigaChat API -> Авторизационные данные
GIGACHAT_CREDENTIALS=your_gigachat_authorization_key_here

# Область API: GIGACHAT_API_PERS (физлица) или GIGACHAT_API_B2B (бизнес)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ===== VK API =====
# Токен сообщества ВКонтакте
# Получить: Управление сообществом -> Управление -> Работа с API -> Ключ доступа
VK_TOKEN=your_vk_community_token_here

# ID сообщества ВКонтакте (без минуса)
VK_GROUP_ID=123456789
