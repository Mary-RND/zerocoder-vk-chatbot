# GitHub Actions workflow
#
# Для активации: скопируйте этот файл в .github/workflows/ci.yml
# и добавьте репозиторию в тонкозернистом PAT разрешение "Workflows" (Read/write):
# GitHub -> Settings -> Developer settings -> Personal access tokens ->
# ваш токен -> Repository permissions -> Workflows -> Read and write.

name: CI

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: [ "3.11", "3.12" ]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
      - name: Install package
        run: pip install -e ".[dev]"
      - name: Run tests
        run: pytest -v